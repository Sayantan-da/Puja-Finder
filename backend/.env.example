# PujaFinder backend configuration
# Copy this file to .env and edit the values.

# ── Database ────────────────────────────────────────────────────────────────
# PRODUCTION (recommended): managed PostgreSQL — Neon.tech / Supabase / RDS
#   Neon pooled connection (app traffic):  .../pujafinder?pgbouncer=true
#   Neon direct connection (migrations):   .../pujafinder  (no pgbouncer param)
# DATABASE_URL=postgresql://user:password@host.neon.tech/pujafinder

# DEVELOPMENT default: local SQLite file (zero setup)
DATABASE_URL=sqlite:///./pujafinder.db

# PostgreSQL pool sizing (ignored for SQLite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Security / admin bootstrap ──────────────────────────────────────────────
# First-deploy ADMIN account (ENVIRONMENT=production creates no demo users):
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=pick-a-strong-password
# JWT settings — CHANGE THIS in production (long random string)
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Redis / Upstash (Optional for multi-server scale) ────────────────────────
# Leave empty for single-instance / local development (uses high-speed in-memory).
# For multi-server production (Render/Railway/Upstash):
# REDIS_URL=rediss://default:your-token@your-endpoint.upstash.io:6379
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
CROWD_REPORT_COOLDOWN_MINUTES=10

# ── Misc ────────────────────────────────────────────────────────────────────
# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DEMO-ONLY synthetic crowd reports (leave OFF in production)
CROWD_SIMULATOR=off
